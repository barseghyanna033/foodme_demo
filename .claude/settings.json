{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-file-changes.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-app-source.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
